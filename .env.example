# ╔══════════════════════════════════════════════════════╗
# ║  SHINEIAPI v2.0.1 — Environment Variables            ║
# ║  github.com/Shineii86/ShineiAPI                      ║
# ╚══════════════════════════════════════════════════════╝
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control!
#
# ─── Toraka API (upstream data source) ───
TORAKA_BASE_URL=https://core.toraka.com/api/v1

# ─── Cache Configuration ───
# TTL in seconds for cached responses (default: 300 = 5 min)
CACHE_TTL=300

# ─── Rate Limiting ───
# Maximum requests per minute per IP
RATE_LIMIT_MAX=60

# ─── Application ───
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://shineiapi.vercel.app

# ──── ShineiAPI · Shineii86 · github.com/Shineii86/ShineiAPI ────
